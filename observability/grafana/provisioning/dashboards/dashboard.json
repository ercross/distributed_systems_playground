{
  "title": "Distributed Systems - Failure First (No Guards v0.1.0)",
  "uid": "dist-sys-failure-v010-tight",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "distributed-systems",
    "failure-first",
    "no-guards",
    "v0.1.0"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "System Shape",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Incoming order requests at edge (req/s)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(order_api_http_requests_total{method=\"POST\",path=\"/orders\"}[1m]))",
          "legendFormat": "POST /orders req/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Edge request latency p95 (POST /orders)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(order_api_http_request_duration_seconds_bucket{method=\"POST\",path=\"/orders\"}[1m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Forward goroutines in-flight",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "order_api_processor_forward_in_flight",
          "legendFormat": "forward_in_flight"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Processor queue depth",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
