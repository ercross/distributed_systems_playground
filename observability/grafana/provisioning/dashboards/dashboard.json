{
  "title": "Distributed Systems - Failure First (v0.2.0 Admission Control)",
  "uid": "dist-sys-failure-v020-admission-control",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "distributed-systems",
    "failure-first",
    "admission-control",
    "v0.2.0"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Ingress Admission Control",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Incoming order requests at edge (req/s)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(order_api_http_requests_total{method=\"POST\",path=\"/orders\"}[30s]))",
          "legendFormat": "POST /orders req/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Admission slots in use vs configured limit",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "order_api_admission_in_use",
          "legendFormat": "in_use"
        },
        {
          "expr": "order_api_admission_limit",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Accepted vs rejected orders (rate)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(order_api_orders_accepted_total[30s])",
          "legendFormat": "accepted/s"
        },
        {
          "expr": "rate(order_api_orders_rejected_total[30s])",
          "legendFormat": "rejected/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Admission vs validation rejections (rate)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "rate(order_api_admission_rejections_total[30s])",
          "legendFormat": "admission_rejections/s"
        },
        {
          "expr": "rate(order_api_validation_rejections_total[30s])",
          "legendFormat": "validation_rejections/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Forwarding goroutines in-flight",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "order_api_processor_forward_in_flight",
          "legendFormat": "forward_in_flight"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Forwarding duration p95",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(order_api_processor_forward_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Internal Flow Without Back-Pressure",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
